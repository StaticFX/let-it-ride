<configuration>
  <!--
    Without this file logback falls back to its default, which is DEBUG for
    every logger on the classpath — so a running server spent most of its
    output on netty's buffer settings.
  -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>

  <logger name="io.netty" level="WARN" />
  <logger name="io.ktor.server.engine" level="INFO" />
</configuration>
